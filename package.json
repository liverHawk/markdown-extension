{
  "name": "checklist-markdown",
  "displayName": "Checklist Markdown",
  "version": "0.1.0",
  "description": "switch display from md to checkbox and edit status of todo list.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liverHawk/markdown-extension.git"
  },
  "publisher": "purple-hawk",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run package-ext",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package-ext": "rolldown src/extension.ts -o out/extension.js -f cjs -p node -e vscode -m",
    "pretest": "pnpm run compile && pnpm run lint && pnpm run fmt:check",
    "lint": "oxlint src",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies",
    "release": "bash ./scripts/release.sh"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.3.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rolldown": "^1.2.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "contributes": {
    "configuration": {
      "title": "Checklist Markdown",
      "properties": {
        "checklistMarkdown.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save the Markdown document when a task checkbox status is changed."
        }
      }
    },
    "commands": [
      {
        "command": "checklist-markdown.openPreview",
        "title": "Checklist Markdown: Open Interactive Preview",
        "icon": "$(checklist)"
      },
      {
        "command": "checklist-markdown.toggleCurrentTask",
        "title": "Checklist Markdown: Toggle Task on Current Line"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "checklist-markdown.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "checklist-markdown.toggleCurrentTask",
          "when": "editorLangId == markdown",
          "group": "modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "checklist-markdown.toggleCurrentTask",
        "key": "alt+x",
        "mac": "alt+x",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "engines": {
    "vscode": "^1.90.0"
  }
}

{
  "name": "checklist-markdown",
  "displayName": "Checklist Markdown",
  "description": "switch display from md to checkbox and edit status of todo list.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "checklist-markdown.openPreview",
        "title": "Checklist Markdown: Open Interactive Preview",
        "icon": "$(checklist)"
      },
      {
        "command": "checklist-markdown.toggleCurrentTask",
        "title": "Checklist Markdown: Toggle Task on Current Line"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "checklist-markdown.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "checklist-markdown.toggleCurrentTask",
          "when": "editorLangId == markdown",
          "group": "modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "checklist-markdown.toggleCurrentTask",
        "key": "alt+x",
        "mac": "alt+x",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "oxlint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  }
}
